{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "seraph-pci-x/spatial",
  "version": "1.0.0",
  "vectors": [
    {
      "id": "point-xy",
      "operation": "point_position",
      "input": {"latitude": 17.4, "longitude": 78.4},
      "expected_lonlat": [78.4, 17.4]
    },
    {
      "id": "antimeridian",
      "operation": "point_in_bbox",
      "input": {
        "point": {"latitude": 0.0, "longitude": 179.0},
        "bbox": {"west": 170.0, "south": -10.0, "east": -170.0, "north": 10.0}
      },
      "expected": true
    },
    {
      "id": "wgs84-equator-degree",
      "operation": "inverse",
      "input": {
        "a": {"latitude": 0.0, "longitude": 0.0},
        "b": {"latitude": 0.0, "longitude": 1.0}
      },
      "expected_distance_m": 111319.49079327357,
      "tolerance_m": 0.01
    },
    {
      "id": "web-mercator-hyderabad-like",
      "operation": "transform_point",
      "input": {"latitude": 17.385, "longitude": 78.4867, "target_crs": "EPSG:3857"},
      "expected_x": 8737099.478044424,
      "expected_y": 1965687.7375145564,
      "tolerance_m": 0.001
    },
    {
      "id": "geodesic-square-area",
      "operation": "polygon_area_m2",
      "input": [
        {"latitude": 0.0, "longitude": 0.0},
        {"latitude": 0.0, "longitude": 1.0},
        {"latitude": 1.0, "longitude": 1.0},
        {"latitude": 0.0, "longitude": 0.0}
      ],
      "expected_area_m2": 6154854786.72143,
      "relative_tolerance": 0.000001
    },
    {
      "id": "geojson-point",
      "operation": "geojson_point",
      "input": {"entity_id": "e", "latitude": 17.4, "longitude": 78.4},
      "expected_coordinates": [78.4, 17.4]
    },
    {
      "id": "jsonfg-utc",
      "operation": "jsonfg_timestamp",
      "input": {"entity_id": "e", "latitude": 17.4, "longitude": 78.4, "time": "2026-01-01T00:00:00Z"},
      "expected_timestamp": "2026-01-01T00:00:00.000000Z"
    },
    {
      "id": "zm-place",
      "operation": "jsonfg_zm_measure",
      "input": {"latitude": 17.4, "longitude": 78.4, "height_m": 650.0, "measure": 42.0},
      "expected_place": [78.4, 17.4, 650.0, 42.0]
    }
  ]
}
