{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seraph.dev/schemas/entity.schema.json",
  "title": "Seraph PCI Entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_id", "entity_type", "canonical_name", "namespace", "epistemic_status", "confidence"],
  "properties": {
    "entity_id": {"type": "string", "minLength": 1},
    "entity_type": {"type": "string"},
    "canonical_name": {"type": "string", "minLength": 1},
    "namespace": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "external_ids": {"type": "object", "additionalProperties": {"type": "string"}},
    "country_code": {"type": ["string", "null"], "minLength": 2, "maxLength": 3},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time"},
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "epistemic_status": {"enum": ["observed", "derived", "inferred", "modeled", "counterfactual", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "properties": {"type": "object"}
  }
}
