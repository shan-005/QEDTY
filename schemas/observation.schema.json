{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seraph.dev/schemas/observation.schema.json",
  "title": "Seraph PCI Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "entity_id", "observed_at", "property_name", "value", "epistemic_status", "confidence"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time"},
    "property_name": {"type": "string", "minLength": 1},
    "value": {},
    "unit": {"type": ["string", "null"]},
    "epistemic_status": {"enum": ["observed", "derived", "inferred", "modeled", "counterfactual", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_record_id": {"type": ["string", "null"]}
  }
}
