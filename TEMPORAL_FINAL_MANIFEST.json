{
  "component": "seraph-tdm-temporal",
  "product": "SERAPH-PCI-X",
  "version": "2.0.0",
  "status": "reference-complete",
  "overlay": true,
  "python_reference": "src/seraph/temporal",
  "compatibility_consumer": ["src/seraph/graph/temporal.py"],
  "contracts": {
    "json_schema": "contracts/temporal/json-schema/temporal.schema.json",
    "protobuf": "proto/seraph/temporal/v1/temporal.proto",
    "arrow": "contracts/temporal/arrow/schema.json",
    "rdf": "contracts/temporal/rdf/temporal.ttl",
    "shacl": "contracts/temporal/shacl/temporal.shacl.ttl"
  },
  "profiles": {
    "interval": "Allen-13+OWL-Time",
    "time": "ISO8601-1:2019+seraph-utc-time@1",
    "bitemporal": "valid-time+transaction-time@1",
    "storage": "half-open-range@[start,end)",
    "query": "OGC-datetime-compatible@1"
  },
  "research_non_claims": [
    "does not implement leap-second parsing or time-scale conversion",
    "does not implement SQL temporal storage; PostgreSQL integration belongs to the storage layer",
    "does not implement temporal graph learning; that belongs to intelligence/modeling layers",
    "does not claim full conformance to every version of OWL-Time, ISO 8601-2, or OGC API standards"
  ]
}
