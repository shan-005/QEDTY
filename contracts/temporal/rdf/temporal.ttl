@prefix time: <http://www.w3.org/2006/time#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qedty: <https://qedty.local/temporal/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

qedty:TemporalExtent a owl:Class ;
    rdfs:subClassOf time:TemporalEntity .

qedty:validTime a owl:ObjectProperty ;
    rdfs:range time:TemporalEntity .

qedty:transactionTime a owl:ObjectProperty ;
    rdfs:range time:TemporalEntity .

qedty:validAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

qedty:transactionAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

qedty:generatedAt a owl:DatatypeProperty ;
    rdfs:subPropertyOf prov:generatedAtTime ;
    rdfs:range xsd:dateTime .
