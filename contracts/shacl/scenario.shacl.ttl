@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix seraph: <https://seraph.example/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

seraph:ScenarioShape a sh:NodeShape ;
    sh:targetClass seraph:Scenario ;
    sh:property [ sh:path seraph:hasBaseWorldDigest ; sh:minCount 1 ] ;
    sh:closed false .

seraph:ShockShape a sh:NodeShape ;
    sh:targetClass seraph:Shock ;
    sh:closed false .

seraph:InterventionShape a sh:NodeShape ;
    sh:targetClass seraph:Intervention ;
    sh:closed false .
