@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qedty: <https://qedty.example/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

qedty:ScenarioShape a sh:NodeShape ;
    sh:targetClass qedty:Scenario ;
    sh:property [ sh:path qedty:hasBaseWorldDigest ; sh:minCount 1 ] ;
    sh:closed false .

qedty:ShockShape a sh:NodeShape ;
    sh:targetClass qedty:Shock ;
    sh:closed false .

qedty:InterventionShape a sh:NodeShape ;
    sh:targetClass qedty:Intervention ;
    sh:closed false .
