@prefix seraph: <https://seraph.local/ontology/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

seraph:EntityShape a sh:NodeShape ;
  sh:targetClass seraph:Entity ;
  sh:property [ sh:path seraph:entityId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path seraph:canonicalName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path seraph:confidence ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] .

seraph:RelationshipShape a sh:NodeShape ;
  sh:targetClass seraph:Relationship ;
  sh:property [ sh:path seraph:source ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path seraph:target ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path seraph:strength ; sh:datatype xsd:double ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] ;
  sh:property [ sh:path seraph:capacityFraction ; sh:datatype xsd:double ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] ;
  sh:property [ sh:path seraph:reliability ; sh:datatype xsd:double ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] .

seraph:EventShape a sh:NodeShape ;
  sh:targetClass seraph:Event ;
  sh:property [ sh:path seraph:eventType ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path seraph:severity ; sh:datatype xsd:double ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] ;
  sh:property [ sh:path seraph:impactFraction ; sh:datatype xsd:double ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] .

seraph:CapabilityShape a sh:NodeShape ;
  sh:targetClass seraph:Capability ;
  sh:property [ sh:path seraph:availabilityFraction ; sh:datatype xsd:double ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] .

seraph:ServiceShape a sh:NodeShape ;
  sh:targetClass seraph:Service ;
  sh:or (
    [ sh:property [ sh:path seraph:provider ; sh:minCount 1 ] ]
    [ sh:property [ sh:path seraph:capability ; sh:minCount 1 ] ]
  ) ;
  sh:property [ sh:path seraph:criticality ; sh:datatype xsd:double ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] ;
  sh:property [ sh:path seraph:availabilityTarget ; sh:datatype xsd:double ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] .

seraph:FlowShape a sh:NodeShape ;
  sh:targetClass seraph:Flow ;
  sh:property [ sh:path seraph:source ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path seraph:target ; sh:minCount 1 ; sh:maxCount 1 ] .

seraph:AssertionShape a sh:NodeShape ;
  sh:targetClass seraph:Assertion ;
  sh:property [ sh:path seraph:subject ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path seraph:predicate ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path seraph:confidence ; sh:datatype xsd:double ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] .

seraph:EntityResolutionShape a sh:NodeShape ;
  sh:targetClass seraph:EntityResolution ;
  sh:property [ sh:path seraph:resolutionEntity ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path seraph:resolutionScore ; sh:datatype xsd:double ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] ;
  sh:property [ sh:path seraph:resolver ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .
