{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "description": "Epistemically qualified semantic statement with explicit subject/object/value.",
      "properties": {
        "asserted_at": {
          "format": "date-time",
          "title": "Asserted At",
          "type": "string"
        },
        "assertion_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "epistemic_status": {
          "$ref": "#/$defs/EpistemicStatus"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/AssertionKind"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "object_entity": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "predicate": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "provenance_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Provenance Ids",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "subject": {
          "$ref": "#/$defs/EntityRef"
        },
        "valid_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "assertion_id",
        "subject",
        "predicate",
        "kind",
        "asserted_at",
        "epistemic_status"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "AssertionKind": {
      "enum": [
        "classification",
        "relationship",
        "attribute",
        "measurement",
        "observation",
        "derivation",
        "hypothesis"
      ],
      "title": "AssertionKind",
      "type": "string"
    },
