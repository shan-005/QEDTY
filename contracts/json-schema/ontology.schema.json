          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "owner": {
          "$ref": "#/$defs/EntityRef"
        },
        "properties": {
          "additionalProperties": true,
          "title": "Properties",
          "type": "object"
        },
        "provenance_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Provenance Ids",
          "type": "array"
        },
        "valid_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
