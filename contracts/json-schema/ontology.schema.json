    "Quantity": {
      "additionalProperties": false,
      "description": "Dimension-checked quantity using Decimal for exact decimal arithmetic.",
      "properties": {
        "unit": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
