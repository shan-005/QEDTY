      "type": "object"
    },
    "CapabilityKind": {
      "enum": [
        "compute",
        "storage",
        "power",
        "communication",
        "positioning",
        "sensing",
        "transport",
        "processing",
        "other"
      ],
      "title": "CapabilityKind",
      "type": "string"
    },
