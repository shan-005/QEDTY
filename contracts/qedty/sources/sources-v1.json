{
  "$id": "https://qedty.dev/schema/sources/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "allowed_hosts": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "configuration_digest": {
      "type": "string"
    },
    "license_scope": {
      "type": "string"
    },
    "max_bytes": {
      "minimum": 1,
      "type": "integer"
    },
    "source_id": {
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "license_scope",
    "configuration_digest"
  ],
  "title": "Source Context",
  "type": "object"
}
