{
  "$id": "https://qedty.dev/schema/storage/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "backend": {
      "enum": [
        "sqlite",
        "parquet",
        "duckdb",
        "postgresql_postgis"
      ]
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schema_version",
    "content_sha256"
  ],
  "title": "Storage Manifest",
  "type": "object"
}
