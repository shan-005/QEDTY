            "source": "a",
            "target": "m",
            "valid_start": "2026-01-05T00:00:00.000001Z",
            "valid_end": null
          },
          {
            "id": "r-expired",
            "source": "z",
            "target": "a",
            "valid_start": null,
            "valid_end": "2026-01-04T23:59:59Z"
          }
