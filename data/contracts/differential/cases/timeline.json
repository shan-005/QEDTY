{
  "schema_version": "qedty-differential-cases@1",
  "cases": [
    {
      "case_id": "timeline-before-selects-latest-prior-001",
      "operation": "timeline.point.query",
      "input": {
        "mode": "at_or_before",
        "query_at": "2026-01-02T12:00:00Z",
        "points": [
          {
            "at": "2026-01-01T00:00:00Z",
            "value": "a"
          },
          {
            "at": "2026-01-02T00:00:00Z",
            "value": "b"
          },
          {
            "at": "2026-01-03T00:00:00Z",
            "value": "c"
          }
        ]
      },
      "comparison": {
        "mode": "exact"
      },
      "expected_result": "b"
    },
