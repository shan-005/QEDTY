{
  "schema_version": "qedty-differential-cases@1",
  "cases": [
    {
      "case_id": "four-gap-bbox-antimeridian-001",
      "operation": "spatial.bbox.query",
      "input": {
        "bbox": {
          "west": 170.0,
          "south": -10.0,
          "east": -170.0,
          "north": 10.0
        },
        "points": [
          {
            "id": "z-east",
            "latitude": 0.0,
            "longitude": 179.0
          },
          {
            "id": "a-west",
            "latitude": 0.0,
            "longitude": -179.0
          },
          {
            "id": "outside",
            "latitude": 0.0,
            "longitude": 0.0
          },
          {
            "id": "north-edge",
            "latitude": 10.0,
            "longitude": 180.0
          },
          {
            "id": "west-edge",
            "latitude": -10.0,
            "longitude": 170.0
          }
        ]
      },
      "comparison": {
        "mode": "exact"
      },
      "expected_result": [
        "a-west",
        "north-edge",
        "west-edge",
        "z-east"
      ]
    },
    {
      "case_id": "four-gap-bbox-inclusive-boundaries-002",
      "operation": "spatial.bbox.query",
      "input": {
        "bbox": {
          "west": -1.0,
          "south": -1.0,
          "east": 1.0,
          "north": 1.0
        },
        "points": [
          {
            "id": "center",
            "latitude": 0.0,
            "longitude": 0.0
          },
          {
            "id": "north",
            "latitude": 1.0,
            "longitude": 0.0
          },
          {
            "id": "east",
            "latitude": 0.0,
            "longitude": 1.0
          },
          {
            "id": "outside",
            "latitude": 1.0001,
            "longitude": 0.0
          },
          {
            "id": "duplicate",
            "latitude": 60.0,
            "longitude": 60.0
          },
          {
            "id": "duplicate",
            "latitude": -1.0,
            "longitude": -1.0
          }
        ]
      },
      "comparison": {
        "mode": "exact"
      },
      "expected_result": [
        "center",
        "duplicate",
        "east",
        "north"
      ]
    },
