{
  "schema_version": "qedty-differential-cases@1",
  "cases": [
    {
      "case_id": "canonical-nested-unicode-001",
      "operation": "canonical_json",
      "input": {
        "value": {
          "z": [
            3,
            true,
            null
          ],
          "a": {
            "β": "planet",
            "a": "QEDTY"
          },
          "text": "line\nend"
        }
      },
      "comparison": {
        "mode": "exact"
      },
      "expected_result": "{\"a\":{\"a\":\"QEDTY\",\"β\":\"planet\"},\"text\":\"line\\nend\",\"z\":[3,true,null]}"
    },
    {
      "case_id": "canonical-number-profile-001",
      "operation": "canonical_json",
      "input": {
        "value": {
          "zero": -0.0,
          "positive_small": 1e-07,
          "negative_small": -1e-07,
          "positive_large": 1e+20,
          "fixed": 0.0001,
          "as_string": "1e-07"
        }
      },
      "comparison": {
        "mode": "exact"
      },
      "expected_result": "{\"as_string\":\"1e-07\",\"fixed\":0.0001,\"negative_small\":-1e-07,\"positive_large\":1e+20,\"positive_small\":1e-07,\"zero\":-0.0}"
    },
